# points-snapshot.js をローカルで試すための設定。
# コピーして .env として保存する。GitHub Actions では代わりに「Secrets」に登録する。
# .env / 鍵ファイルは絶対に共有・コミットしないこと（.gitignore 済み）。

# 必須 --------------------------------------------------------------

# withny にログインしたブラウザのセッション Cookie。取り方は README の
# 「セッショントークンが見つからないとき」を参照。次のどれでもよい:
#   (a) __Secure-next-auth.session-token の「値」だけ
#   (b) `__Secure-next-auth.session-token=xxxxx` のような name=value 断片
#   (c) 分割されている場合の `...session-token.0=..; ...session-token.1=..` をそのまま
WITHNY_SESSION_TOKEN=

# 記録先スプレッドシートの ID（URL の /d/ と /edit の間の文字列）
SPREADSHEET_ID=

# Google サービスアカウント鍵 JSON の「中身そのもの」を 1 行で貼り付ける。
# （ローカルでは下のようにファイルを読ませてもよい: 行を消して代わりに
#  GOOGLE_SERVICE_ACCOUNT_JSON=$(cat service-account.json) のようにシェルで渡す）
GOOGLE_SERVICE_ACCOUNT_JSON=

# 任意 --------------------------------------------------------------

# 書き込み先シート名（既定 data2 / Code.gs と合わせる）
SHEET_NAME=data2

# 1 配信あたりソケット応答を待つ最大ミリ秒
PER_STREAM_TIMEOUT_MS=20000

# ソケット同時接続数
CONCURRENCY=12

# 1 回の実行で処理する配信数の上限
MAX_STREAMS=80
